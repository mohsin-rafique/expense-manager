# Normalize all text files to LF in the repo
* text=auto eol=lf

# PHP, JS, CSS, HTML — always LF
*.php text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.env  text eol=lf
*.example text eol=lf
*.sql  text eol=lf

# Windows-specific files — keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.xlsx binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
