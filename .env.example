# Copy this file to .env and fill in your values
# cp .env.example .env

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------
YII_DEBUG=false
YII_ENV=prod

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
DB_DSN=mysql:host=localhost;dbname=expense_manager
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------
# Session Security
# Set SESSION_SECURE=true when running behind HTTPS
# SESSION_SAMESITE options: Lax, Strict, None
# -----------------------------------------------------------------------
SESSION_SECURE=false
SESSION_SAMESITE=Lax
